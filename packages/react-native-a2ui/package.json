{
  "name": "react-native-a2ui",
  "version": "0.0.0",
  "description": "React Native renderer for Google's A2UI protocol — agents compose real native UI, streaming, on the open A2UI standard. Built on the official @a2ui/web_core engine. Works in Expo (including Expo Go) and bare React Native.",
  "main": "./lib/module/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./engine-types": {
      "source": "./src/engine/types.ts",
      "types": "./lib/typescript/src/engine/types.d.ts",
      "default": "./lib/module/engine/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/*.test.*",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "sideEffects": false,
  "dependencies": {
    "@a2ui/web_core": "0.10.4"
  },
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && jest",
    "test:vitest": "vitest",
    "test:jest": "jest"
  },
  "keywords": [
    "react-native",
    "a2ui",
    "expo",
    "generative-ui",
    "agent",
    "ai",
    "llm",
    "a2a",
    "server-driven-ui",
    "google",
    "gemini",
    "claude",
    "streaming-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luizhbesper/react-native-a2ui.git",
    "directory": "packages/react-native-a2ui"
  },
  "author": "Luiz Esper <luiz.hb.esper@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/luizhbesper/react-native-a2ui#readme",
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "{**/__tests__/**,**/__fixtures__/**,**/__mocks__/**,**/*.test.*}",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.86.0",
    "@react-native/jest-preset": "^0.86.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.17",
    "jest": "^29.7.0",
    "react": "^19.2.7",
    "react-native": "^0.86.0",
    "react-native-builder-bob": "^0.43.0",
    "react-test-renderer": "^19.2.7",
    "vitest": "^4.1.10"
  }
}
